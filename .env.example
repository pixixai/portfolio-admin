# Create the private .env.cloud with: npm run configure:cloud
# Local startup does not load this file.
PORTFOLIO_MODE=cloud
PORTFOLIO_ADMIN_ORIGIN=https://admin.example.com
PORTFOLIO_SITE_ORIGIN=https://example.com
PORTFOLIO_DATA_DIR=/var/lib/portfolio-admin/user
PORTFOLIO_ADMIN_USER=admin
# Set using the configuration command; never put a plaintext password here.
PORTFOLIO_ADMIN_PASSWORD_HASH=
PORTFOLIO_TRUST_PROXY=true
PORT=4180
