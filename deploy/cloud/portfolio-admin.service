[Unit]
Description=Portfolio administration and published website
After=network.target

[Service]
Type=simple
User=www
Group=www
WorkingDirectory=/opt/portfolio-admin
Environment=NODE_ENV=production
ExecStart=/usr/bin/node --env-file=/opt/portfolio-admin/.env.cloud /opt/portfolio-admin/server.mjs --cloud
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/portfolio-admin
UMask=0077

[Install]
WantedBy=multi-user.target
